{
  "name": "broteam-translate-bot",
  "private": true,
  "license": "WTFPL",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "manual": "node dist/src/index.js",
    "manual:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "debug": "ts-node-dev --respawn --transpile-only --inspect=9229 src/index.ts",
    "ci:quick": "npm ci && npm run lint && npm run build && npm test",
    "lint": "node scripts/check-eslint-node-version.js && eslint src scripts --ext .ts,.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "translate:one": "ts-node src/scripts/translateOne.ts",
    "test:tokens": "ts-node src/scripts/testTokenizer.ts",
    "test:humor": "ts-node src/scripts/testHumorScorer.ts",
    "resolve:user": "ts-node src/scripts/resolveUserId.ts",
    "oauth2:auth": "ts-node src/scripts/oauth2Authorize.ts",
    "oauth2:handle": "ts-node src/scripts/oauth2HandleCode.ts",
    "oauth2:check": "ts-node src/scripts/checkOAuth2Health.ts",
    "admin": "ts-node src/scripts/adminCli.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "flatted": "^3.4.2",
    "langdetect": "^0.2.1",
    "twitter-api-v2": "^1.14.0",
    "winston": "^3.8.2"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "pm2": "^7.0.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "systeminformation": ">=5.30.8",
    "flatted": "$flatted",
    "handlebars": ">=4.7.9"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testTimeout": 30000,
    "maxWorkers": "50%",
    "detectOpenHandles": true,
    "forceExit": false
  },
  "version": "0.12.1"
}
